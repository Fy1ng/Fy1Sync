{
  "name": "stream-syncer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local web tool that aligns an official clean esports stream with a Chinese commentary stream, with danmaku overlay and countdown-based automatic sync.",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node scripts/start-dev.mjs",
    "build": "npm run typecheck && vite build && node scripts/build-server.mjs",
    "start": "node dist/server/index.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "smoke": "node scripts/smoke.mjs",
  "shots": "node scripts/ui-shots.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json && tsc -p tsconfig.e2e.json",
    "fixtures": "node scripts/generate-test-sources.mjs"
  },
  "dependencies": {
    "hls.js": "1.6.16",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "25.9.1",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.4",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "vite": "8.0.14",
    "vitest": "4.1.7"
  }
}
