{
  "name": "fy1sync",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "description": "Electron desktop app for aligned esports video, commentary and danmaku.",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/start-dev.mjs",
    "build": "npm run build:wasm && npm run typecheck && vite build && node scripts/build-electron.mjs",
    "start": "node scripts/start-electron.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "smoke": "playwright test e2e/smoke.spec.ts",
    "shots": "node scripts/ui-shots.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json && tsc -p tsconfig.e2e.json",
    "fixtures": "node scripts/generate-test-sources.mjs",
    "build:wasm": "node scripts/build-wasm.mjs",
    "tools:prepare": "node scripts/prepare-tools.mjs",
    "package:prepare": "node scripts/prepare-package.mjs",
    "package:win": "node scripts/package-win.mjs",
    "package:check": "node scripts/check-package.mjs"
  },
  "dependencies": {
    "hls.js": "1.6.16",
    "parse5": "8.0.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "undici": "7.30.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "25.9.1",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "electron": "44.9.3",
    "electron-builder": "26.15.3",
    "fake-indexeddb": "6.2.4",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  },
  "overrides": {
    "undici@^7.0.0": "$undici",
    "undici@^6.0.0": "6.29.1",
    "source-map-js": "1.2.2"
  },
  "main": "dist/electron/main.cjs"
}
